@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# MICS is required by the header-only runtime and by every optional library.
# Also search the ABIX prefix so `-DABIX_DIR=<prefix>/lib/cmake/ABIX` works with
# the bundled MICS package without requiring a separate CMAKE_PREFIX_PATH.
find_dependency(MICS CONFIG REQUIRED PATHS "${PACKAGE_PREFIX_DIR}")

set(ABIX_HAS_LIBRARIES "@ABIX_HAS_LIBRARIES@")
set(_abix_need_fmt OFF)
if(ABIX_HAS_LIBRARIES)
    if(ABIX_FIND_COMPONENTS)
        # Explicit component requests decide whether the fmt-backed libraries
        # are needed. `find_package(ABIX COMPONENTS runtime)` must not require
        # fmt.
        foreach(_abix_component IN LISTS ABIX_FIND_COMPONENTS)
            if(_abix_component STREQUAL "format"
               OR _abix_component STREQUAL "abi"
               OR _abix_component STREQUAL "metadata"
               OR _abix_component STREQUAL "tools"
               OR _abix_component STREQUAL "ABIX")
                set(_abix_need_fmt ON)
            endif()
        endforeach()
    else()
        # The default package includes ABIX::ABIX, which aggregates the
        # optional libraries, so fmt is needed for the full package.
        set(_abix_need_fmt ON)
    endif()
endif()
if(_abix_need_fmt)
    find_dependency(fmt CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ABIXTargets.cmake")

set(ABIX_VERSION "@PROJECT_VERSION@")
set_and_check(ABIX_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(ABIX_INCLUDE_DIRS "${ABIX_INCLUDE_DIR}")

set(ABIX_runtime_FOUND TRUE)
set(ABIX_ABIX_FOUND TRUE)
if(ABIX_HAS_LIBRARIES)
    set(ABIX_format_FOUND TRUE)
    set(ABIX_abi_FOUND TRUE)
    set(ABIX_metadata_FOUND TRUE)
    set(ABIX_tools_FOUND TRUE)
else()
    set(ABIX_format_FOUND FALSE)
    set(ABIX_abi_FOUND FALSE)
    set(ABIX_metadata_FOUND FALSE)
    set(ABIX_tools_FOUND FALSE)
endif()

check_required_components(ABIX)

unset(_abix_component)
unset(_abix_need_fmt)
unset(ABIX_HAS_LIBRARIES)
