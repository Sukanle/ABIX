@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# AMC consumes the ABIX runtime headers/MICS and builds its own artifact
# libraries. fmt is required by AMC::format.
find_dependency(ABIX 0.3 CONFIG COMPONENTS runtime)
find_dependency(fmt CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/AMCTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/AMC.cmake")

set(AMC_VERSION "@PROJECT_VERSION@")
set_and_check(AMC_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(AMC_INCLUDE_DIRS "${AMC_INCLUDE_DIR}")

if(TARGET AMC::amc)
    set(AMC_EXECUTABLE "$<TARGET_FILE:AMC::amc>")
endif()

check_required_components(AMC)
